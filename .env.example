# Copy to .env.local for `npm run dev`. In production set these in
# Vercel > Project > Settings > Environment Variables. Never commit real values.

# Required for online enquiries
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...
# One hostname, or several separated by commas (no https://, no path)
SITE_HOSTNAME=svicontrolpanel.com,www.svicontrolpanel.com

# Daily keep-alive for Supabase Free plan (any long random string)
CRON_SECRET=

# Optional: email each new enquiry to the owner via Resend
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
# Leave blank until the domain is verified in Resend; then e.g. SVI Website <website@svicontrolpanel.com>
NOTIFY_EMAIL_FROM=

# Local testing only: fake Turnstile/Supabase/Resend responses in `npm run dev`
# MOCK_SERVICES=1
